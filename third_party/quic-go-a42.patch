+	case <-second.entered:
+	case <-time.After(time.Second):
+		close(first.release)
+		t.Fatal("second request serialized behind blocked stream I/O")
+	}
+	close(first.release)
+	close(second.release)
+	for range 2 {
+		if err := <-errors; err != nil {
+			t.Fatal(err)
