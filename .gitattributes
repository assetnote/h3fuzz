* text=auto

*.go text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

third_party/** linguist-vendored
# Bundled dependencies can contain whitespace inside generated template
# literals. Treat the reproducible build output as generated instead of
# rewriting those upstream bytes for diff whitespace checks.
web/dist/** -whitespace linguist-generated
final.txt linguist-generated
# The generated bundle preserves upstream notice bytes so its embedded
# SHA-256 identifiers continue to describe the committed verbatim sections.
THIRD_PARTY_LICENSES.txt -text linguist-generated
